#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# ///
"""Gate self-hosted GitHub runners by host load. See fleet/README.md."""
import base64, json, socket, subprocess, sys, time, tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOME_DIR = Path.home() / ".config/fleet"
GATE_LABEL = "com.noisyneighborstudio.fleet-gate"

SNAPSHOT = r"""
echo "ncpu=$(sysctl -n hw.ncpu)"
echo "load=$(sysctl -n vm.loadavg | tr -d '{}')"
echo "disk_kb=$(df -k / | awk 'NR==2{print $4}')"
echo "mem_free=$(memory_pressure -Q | awk -F': ' '/percentage/{print $2+0}')"
echo "drained=$(test -f ~/.config/fleet/drained && echo 1 || echo 0)"
for f in ~/Library/LaunchAgents/actions.runner.*.plist; do
  [ -f "$f" ] || continue
  label=$(basename "$f" .plist)
  dir=$(dirname "$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$f")")
  loaded=0; launchctl list "$label" >/dev/null 2>&1 && loaded=1
  busy=0; pgrep -f "$dir/bin/Runner.Worker" >/dev/null && busy=1
  echo "runner=$loaded $busy $(tr -d '\r\n' < "$dir/.runner")"
done
[ -f ~/.config/fleet/last.json ] && echo "gate=$(cat ~/.config/fleet/last.json)"
true
"""


def load_config():
    path = HOME_DIR / "fleet.toml"
    return tomllib.loads((path if path.exists() else HERE / "fleet.toml").read_text())


def is_local(host):
    return host.get("hostname") == socket.gethostname().split(".")[0]


def run_on(host, script, timeout=30):
    args = ["bash", "-s"] if is_local(host) else \
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", host["ssh"], "bash -s"]
    p = subprocess.run(args, input=script, capture_output=True, text=True, timeout=timeout)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip()[-300:])
    return p.stdout


def parse_snapshot(text):
    snap = {"runners": [], "gate": None}
    for line in text.splitlines():
        key, _, value = line.partition("=")
        if key == "runner":
            loaded, busy, meta = value.split(" ", 2)
            meta = json.loads(meta.lstrip("﻿"))
            snap["runners"].append({"name": meta["agentName"], "id": meta["agentId"],
                                    "repo": meta["gitHubUrl"].removeprefix("https://github.com/"),
                                    "loaded": loaded == "1", "busy": busy == "1"})
        elif key == "gate":
            snap["gate"] = json.loads(value)
        elif key == "load":
            snap["load1"], snap["load5"], _ = map(float, value.split())
        elif key in ("ncpu", "disk_kb", "mem_free", "drained"):
            snap[key] = int(value)
    return snap


def decide(was_open, snap, gate):
    """Return (open, reason). Hysteresis keeps a host from flapping between ticks."""
    if snap["drained"]:
        return False, "drained"
    if snap["disk_kb"] < gate["min_disk_gb"] * 1024 * 1024:
        return False, f"disk {snap['disk_kb'] // 1048576} GB free"
    if snap["mem_free"] < gate["min_mem_free_pct"]:
        return False, f"memory {snap['mem_free']}% free"
    if was_open and snap["load1"] / snap["ncpu"] > gate["close_load"]:
        return False, f"load1 {snap['load1'] / snap['ncpu']:.2f}/core"
    if not was_open and snap["load5"] / snap["ncpu"] >= gate["open_load"]:
        return False, f"load5 {snap['load5'] / snap['ncpu']:.2f}/core, waiting"
    return True, "ok"


def gh(*args):
    p = subprocess.run(["gh", "api", *args], capture_output=True, text=True, timeout=30)
    if p.returncode:
        raise RuntimeError(p.stderr.strip())
    return json.loads(p.stdout) if p.stdout.strip() else None


def cmd_gate(config, args):
    """One tick, run on the host itself by launchd every minute. --dry-run changes nothing."""
    gate, label = config["gate"], config["gate"]["label"]
    snap = parse_snapshot(subprocess.run(["bash", "-c", SNAPSHOT], capture_output=True,
                                         text=True, check=True).stdout)
    runners, repos = [r for r in snap["runners"] if r["loaded"]], {}
    for r in runners:
        repos.setdefault(r["repo"], []).append(r)
    labels = {}
    for repo in list(repos):
        canonical = gh(f"repos/{repo}")["full_name"]
        listed = gh(f"repos/{canonical}/actions/runners?per_page=100")["runners"]
        for r in repos[repo]:
            r["repo"] = canonical
            match = next((x for x in listed if x["id"] == r["id"]), None)
            if match:
                labels[r["name"]] = {x["name"] for x in match["labels"]}
    was_open = any(label in v for v in labels.values())
    want, reason = decide(was_open, snap, gate)
    if "--dry-run" in args:
        print(f"{'open' if want else 'closed'} ({reason}); labelled now: {sorted(n for n, v in labels.items() if label in v)}")
        return
    for r in (r for r in runners if r["name"] in labels):
        has = label in labels[r["name"]]
        if want and not has:
            gh("-X", "POST", f"repos/{r['repo']}/actions/runners/{r['id']}/labels", "-f", f"labels[]={label}")
        elif not want and has:
            gh("-X", "DELETE", f"repos/{r['repo']}/actions/runners/{r['id']}/labels/{label}")
    if want != was_open:
        print(f"{time.strftime('%F %T')} {'opened' if want else 'closed'}: {reason}", flush=True)
    HOME_DIR.mkdir(parents=True, exist_ok=True)
    (HOME_DIR / "last.json").write_text(json.dumps({"ts": int(time.time()), "open": want, "reason": reason}))


def snapshot(host):
    try:
        return parse_snapshot(run_on(host, SNAPSHOT))
    except Exception as error:
        return {"error": str(error)}


def cmd_status(config, _args):
    hosts = config["hosts"]
    reachable = {n: h for n, h in hosts.items() if h["state"] != "hands-off"}
    with ThreadPoolExecutor() as pool:
        snaps = dict(zip(reachable, pool.map(snapshot, reachable.values())))
    rows = [("HOST", "STATE", "GATE", "LOAD/CORE", "MEM FREE", "DISK", "RUNNERS", "BUSY", "SLOTS")]
    notes = []
    for name, host in hosts.items():
        s = snaps.get(name)
        if s is None:
            rows.append((name, host["state"], "-", "-", "-", "-", "-", "-", str(host["slots"])))
        elif "error" in s:
            rows.append((name, host["state"], "unreachable", *["-"] * 5, str(host["slots"])))
            notes.append(f"{name}: {s['error']}")
        else:
            g = s["gate"]
            gate = "not installed" if not g else \
                ("stale" if time.time() - g["ts"] > 180 else ("open" if g["open"] else "closed"))
            if g and not g["open"]:
                notes.append(f"{name}: closed, {g['reason']}")
            loaded = [r for r in s["runners"] if r["loaded"]]
            if len(loaded) != host["slots"]:
                notes.append(f"{name}: {len(loaded)} runners loaded, {host['slots']} slots planned")
            rows.append((name, host["state"], gate, f"{s['load1'] / s['ncpu']:.2f}", f"{s['mem_free']}%",
                         f"{s['disk_kb'] // 1048576} GB", str(len(loaded)),
                         str(sum(r["busy"] for r in loaded)), str(host["slots"])))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)))
    for n in notes:
        print("· " + n)


def writable_host(config, name):
    host = config["hosts"].get(name)
    if not host:
        sys.exit(f"unknown host {name}; see fleet.toml")
    if host["state"] in ("hands-off", "excluded"):
        sys.exit(f"{name} is {host['state']}; fleet will not change it")
    return host


def cmd_drain(config, args, drained=True):
    host = writable_host(config, args[0])
    flag = "touch ~/.config/fleet/drained" if drained else "rm -f ~/.config/fleet/drained"
    run_on(host, f"mkdir -p ~/.config/fleet && {flag} && launchctl kickstart gui/$(id -u)/{GATE_LABEL}")
    print(f"{args[0]} {'drained' if drained else 'opened'}; the gate applies it now")


def cmd_install(config, args):
    host = writable_host(config, args[0])
    files = {name: base64.b64encode((HERE / name).read_bytes()).decode() for name in ("fleet", "fleet.toml")}
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{GATE_LABEL}</string>
<key>ProgramArguments</key><array><string>$HOME/.config/fleet/fleet</string><string>gate</string></array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>StartInterval</key><integer>60</integer><key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>$HOME/Library/Logs/fleet-gate.log</string>
<key>StandardErrorPath</key><string>$HOME/Library/Logs/fleet-gate.log</string>
</dict></plist>"""
    script = "set -e; mkdir -p ~/.config/fleet\n"
    for name, body in files.items():
        script += f"echo {body} | base64 -D > ~/.config/fleet/{name}\n"
    script += f"""chmod +x ~/.config/fleet/fleet
cat > ~/Library/LaunchAgents/{GATE_LABEL}.plist <<FLEET_EOF
{plist}
FLEET_EOF
launchctl bootout gui/$(id -u)/{GATE_LABEL} 2>/dev/null || true
launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/{GATE_LABEL}.plist
"""
    run_on(host, script, timeout=60)
    print(f"gate installed on {args[0]}; log: ~/Library/Logs/fleet-gate.log")


COMMANDS = {"status": cmd_status, "gate": cmd_gate, "install": cmd_install,
            "drain": cmd_drain, "open": lambda c, a: cmd_drain(c, a, drained=False)}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit("usage: fleet status | install <host> | drain <host> | open <host> | gate")
    COMMANDS[sys.argv[1]](load_config(), sys.argv[2:])
